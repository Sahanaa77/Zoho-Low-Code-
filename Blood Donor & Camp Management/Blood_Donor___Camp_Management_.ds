 application "Blood Donor & Camp Management "
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Blood_Camp_Management
		{
			displayname = "Blood Camp Management"
			success message = "Blood Camp Management Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Camp_Name
			(
    			type = text
				displayname = "Camp Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Camp_Date
			(
    			type = date
				displayname = "Camp Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Venue
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Organizer
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Contact_Number
			(
    			type = phonenumber
				displayname = "Contact Number"
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Expected_Donors
			(
				type = number
				displayname = "Expected Donors"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Camp_Status
			(
				type = picklist
				displayname = "Camp Status"
				maxchar = 100
				values = {"Upcoming","Ongoing","Completed","Cancelled"}
				initial value = "Upcoming"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Description
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Blood_Inventory
