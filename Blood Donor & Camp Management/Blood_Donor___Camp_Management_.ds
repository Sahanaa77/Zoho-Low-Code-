	pages
	{
		page Blood_Donor_Camp_Management_Dashboard
		{
			displayname = "Blood Donor & Camp Management Dashboard"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='50%'\n   \t>\n\t<chart \n\telementName='Chart'\n\n\ttype = 'Column'\n\txtitle = 'Blood Group'\n\tytitle = 'Available Units'\n\tbgColor = '#FEFFEB'\n\ttheme = '#4C7DE8'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Blood_Inventory'\n\txfield = 'Blood_Group'\n\tyfields = 'sum:Available_Units'\n/>\n\n</column><column\n   \t\t width='50%'\n   \t>\n\t<chart \n\telementName='Chart 1'\n\n\ttype = 'Line'\n\txtitle = 'Donation Date'\n\tytitle = 'Total records'\n\tbgColor = '#FFF2ED'\n\ttheme = 'theme1'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Donation_Management'\n\txfield = 'Donation_Date'\n\tyfields = 'count:ID'\n/>\n\n</column>\n</row><row>\n\t<column\n   \t\t width='50%'\n   \t>\n\t<chart \n\telementName='Chart 2'\n\n\ttype = 'Pie'\n\txtitle = 'Request Status'\n\tytitle = 'Count of records'\n\tbgColor = '#E0FFEB'\n\ttheme = '#E19351'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Blood_Requests'\n\txfield = 'Request_Status'\n\tyfields = 'count:ID'\n/>\n\n</column><column\n   \t\t width='50%'\n   \t>\n\t<chart \n\telementName='Chart 3'\n\n\ttype = 'Donut'\n\txtitle = 'Donation Status'\n\tytitle = 'Number of Donations'\n\tbgColor = '#FFEDF2'\n\ttheme = 'theme1'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Donation_Management'\n\txfield = 'Donation_Status'\n\tyfields = 'count:ID'\n/>\n\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'All_Blood_Requests'\n\t\n\t\tiszreport = 'false'\n\t\t\t\t\tzc_AddRec = 'false'\n\t\t\t\t\tzc_EditRec = 'false'\n\t\t\t\t\tzc_Print = 'false'\n\t\t\t\t\tzc_DelRec = 'false'\n\t\t\t\t\tzc_DuplRec = 'false'\n\t\t\t\t\tzc_EditBulkRec = 'false'\n\t\t\t\t\tzc_BulkDelete = 'false'\n\t\t\t\t\tzc_BulkDuplicate = 'false'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column>\n</row>\n</layout>\n</zml>"
		}
	}




		workflow
		{
		form
		{
			Update_Inventory_After_Do as "Update Inventory After Donation"
			{
				type =  form
				form = Donation_Management

				record event = on add

				on success
				{
					actions  (Donation_Status == "Collected")
					{
						custom deluge script
						(
											donationRecord = Donation_Management[ID == input.ID];
										if(donationRecord.ID != null && donationRecord.Donation_Status == "Collected" && ifnull(donationRecord.Quantity_Units,0) > 0)
										{
											donorRecord = Donor_Registration[ID == donationRecord.Donor];
											if(donorRecord.ID != null)
											{
												bloodGroupValue = donorRecord.Blood_Group;
												inventoryRecord = Blood_Inventory[Blood_Group == bloodGroupValue];
												if(inventoryRecord.ID != null)
												{
													inventoryRecord.Available_Units=ifnull(inventoryRecord.Available_Units,0) + donationRecord.Quantity_Units;
													inventoryRecord.Last_Updated=zoho.currentdate;
												}
											}
										}
						)
					}
				}

			}
			Update_Inventory_After_Bl as "Update Inventory After Blood Issue"
			{
				type =  form
				form = Blood_Requests

				record event = on add or edit

				on success
				{
					actions  (Units_Issued > 0)
					{
						custom deluge script
						(
											requestRecord = Blood_Requests[ID == input.ID];
										if(requestRecord.Request_Status == "Partially Issued" || requestRecord.Request_Status == "Completed")
										{
											groupValue = requestRecord.Blood_Group;
											issuedUnits = ifnull(requestRecord.Units_Issued,0);
											previouslyDeducted = ifnull(requestRecord.Units_Previously_Deducted,0);
											inventoryRecord = Blood_Inventory[Blood_Group == groupValue];
											if(inventoryRecord.ID != null)
											{
												availableUnits = ifnull(inventoryRecord.Available_Units,0);
												difference = issuedUnits - previouslyDeducted;
												if(difference > 0 && availableUnits >= difference)
												{
													inventoryRecord.Available_Units=availableUnits - difference;
													requestRecord.Units_Previously_Deducted=issuedUnits;
													inventoryRecord.Last_Updated=zoho.currentdate;
												}
												else if(difference < 0)
												{
													inventoryRecord.Available_Units=availableUnits + 0 - difference;
													requestRecord.Units_Previously_Deducted=issuedUnits;
													inventoryRecord.Last_Updated=zoho.currentdate;
												}
											}
										}
						)
					}
				}

			}
			Validate_Blood_Request as "Validate Blood Request"
			{
				type =  form
				form = Blood_Requests

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Units_Required <= 0)
										{
											alert "Units Required must be greater than zero.";
											cancel submit;
										}
										if(input.Units_Issued < 0)
										{
											alert "Units Issued cannot be negative.";
											cancel submit;
										}
										if(input.Units_Issued > input.Units_Required)
										{
											alert "Units Issued cannot exceed Units Required.";
											cancel submit;
										}
						)
					}
				}

			}
			Low_Stock_Alert as "Low Stock Alert"
			{
				type =  form
				form = Blood_Inventory

				record event = on add or edit

				on success
				{
					actions  (Available_Units <= 2)
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : "sahanashreevs07@gmail.com"
							subject : "Critical Blood stock alert"
							message : "<p><span>Critical Blood Stock Alert!</span><br></p><p><span>Blood Group: ${Blood_Group}</span><br></p><p><span>Available Units: ${Available_Units}</span><br></p><p><span>The blood stock has reached a critical level (2 units or less).</span><br></p><p><span>Please arrange for additional blood donations.</span><br></p><div><br></div>"
						)
					}
					actions  (Available_Units >= 3 && Available_Units <= 5)
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : "sahanashreevs07@gmail.com"
							subject : "LOW BLOOD STOCK ALERT"
							message : "<p><span>LOW BLOOD STOCK ALERT!</span><br></p><p><span>Blood Group: ${Blood_Group}</span><br></p><p><span>Available Units: ${Available_Units}</span><br></p><p><span>Warning: The available blood stock has reached a low level (between 3 and 5 units).</span><br></p><p><span>Please arrange for additional blood donations to maintain sufficient inventory.</span><br></p><p><span>Blood Donor &amp; Camp Management System${Blood_Group}${Available_Units}</span><br></p><div><br></div>"
						)
					}
				}

			}
		}






	}
